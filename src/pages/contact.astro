---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactSection from '../components/ContactSection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Contact Us" }
];
---

<Layout
  title="Contact 24/7 Drain Dispatch | Rapid Flow Drain Pros"
  description="Contact Rapid Flow Drain Pros for 24/7 emergency drain cleaning and hydro jetting. Call (877) 823-0231 or request a priority quote online."
  canonicalUrl="https://maxsonplumbing.com/contact/"
>
  <Breadcrumb items={breadcrumbItems} />

  <!-- Contact Hero -->
  <section class="contact-hero">
    <div class="container">
      <span class="badge-pill">24/7 National Dispatch Hub</span>
      <h1 class="page-title">Contact <span class="highlight-text">Rapid Flow Drain Pros</span></h1>
      <p class="page-lead">
        Connect with our emergency dispatch coordinators for immediate technician routing or schedule scheduled maintenance.
      </p>
      <div class="hero-actions">
        <a href="tel:+18778230231" class="btn btn-emergency">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Direct 24/7 Line: (877) 823-0231
        </a>
      </div>
    </div>
  </section>

  <ContactSection />
  <FAQAccordion />
</Layout>

<style>
  .contact-hero {
    background: linear-gradient(160deg, #040d1f 0%, #0a1e3d 40%, #0f2847 70%, #132e52 100%);
    color: var(--color-white);
    padding: 4.5rem 0;
    text-align: center;
  }

  .badge-pill {
    background: rgba(234, 88, 12, 0.2);
    border: 1px solid rgba(234, 88, 12, 0.45);
    color: #fb923c;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: 2.75rem;
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 700px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
  }
</style>
