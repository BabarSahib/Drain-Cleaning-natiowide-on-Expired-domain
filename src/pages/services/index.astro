---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContactSection from '../../components/ContactSection.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { services, getServiceImage } from '../../data/services';

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Services" }
];
---

<Layout
  title="All Drain Cleaning & Sewer Services | Rapid Flow Drain Pros"
  description="Explore our 19 comprehensive drain cleaning and sewer services. From 24/7 emergency unclogging to 4,000 PSI hydro jetting. Call (877) 823-0231!"
  canonicalUrl="https://maxsonplumbing.com/services/"
>
  <Breadcrumb items={breadcrumbItems} />

  <!-- Page Header -->
  <section class="services-hero">
    <div class="container">
      <span class="badge-pill">Nationwide Drain & Sewer Solutions</span>
      <h1 class="page-title">Comprehensive <span class="highlight-text">Drain Cleaning Services</span></h1>
      <p class="page-lead">
        Rapid Flow Drain Pros provides 24/7 same-day drain cleaning, hydro-jetting, and sewer maintenance for residential and commercial properties nationwide. Backed by upfront flat-rate pricing and licensed master technicians.
      </p>
      <div class="hero-actions">
        <a href="tel:+18778230231" class="btn btn-emergency">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Call For Immediate Service: (877) 823-0231
        </a>
      </div>
    </div>
  </section>

  <!-- Services Grid Section -->
  <section class="section-padding services-grid-section">
    <div class="container">
      <div class="grid-header">
        <h2>Browse Our 19 Specialized Drain & Sewer Services</h2>
        <p>Select any service below to view detailed procedures, equipment used, flat-rate pricing, and technician availability.</p>
      </div>

      <div class="services-directory-grid">
        {services.map((srv, index) => (
          <div class="service-card">
            <div class="service-card-img-holder">
              <img src={getServiceImage(srv.slug)} alt={srv.name} class="service-card-img" loading="lazy" />
              <div class="service-num-badge">#{index + 1}</div>
            </div>
            <div class="service-card-body">
              <h3 class="service-name">
                <a href={`/services/${srv.slug}/`}>{srv.name}</a>
              </h3>
              <p class="service-desc">{srv.shortDesc}</p>
              <ul class="service-features-list">
                {srv.features.slice(0, 3).map((f) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <a href={`/services/${srv.slug}/`} class="service-btn">
                View Service Details
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Emergency Strip -->
  <section class="emergency-strip">
    <div class="container strip-content">
      <div>
        <h3>Facing An Urgent Sewer Backup Right Now?</h3>
        <p>Our mobile units arrive in 30 to 45 minutes with hydro-jetters and root cutting augers ready.</p>
      </div>
      <a href="tel:+18778230231" class="btn btn-emergency">
        Call 24/7 Hotline: (877) 823-0231
      </a>
    </div>
  </section>

  <FAQAccordion />
  <ContactSection />
</Layout>

<style>
  .services-hero {
    background: linear-gradient(160deg, #040d1f 0%, #0a1e3d 40%, #0f2847 70%, #132e52 100%);
    color: var(--color-white);
    padding: 4.5rem 0;
    text-align: center;
  }

  .badge-pill {
    background: rgba(234, 88, 12, 0.2);
    border: 1px solid rgba(234, 88, 12, 0.45);
    color: #fb923c;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .page-title {
    font-size: 2.75rem;
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 780px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .services-grid-section {
    background: var(--color-slate-50);
  }

  .grid-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3rem auto;
  }

  .grid-header h2 {
    font-size: 2.1rem;
    color: var(--color-primary-950);
    margin-bottom: 0.5rem;
  }

  .grid-header p {
    color: var(--color-slate-600);
    font-size: 1rem;
  }

  .services-directory-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .service-card {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.09);
    border-color: #2563eb;
  }

  .service-card-img-holder {
    position: relative;
    width: 100%;
    height: 180px;
    background: #0f172a;
    overflow: hidden;
  }

  .service-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-card-img {
    transform: scale(1.05);
  }

  .service-num-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 0.8rem;
    font-weight: 800;
    color: #ffffff;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .service-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-name {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
    padding-right: 2.5rem;
  }

  .service-name a {
    color: var(--color-primary-950);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .service-name a:hover {
    color: var(--color-primary-600);
  }

  .service-desc {
    color: var(--color-slate-600);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .service-features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding: 0;
    border-top: 1px solid var(--color-slate-100);
    padding-top: 1rem;
  }

  .service-features-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    color: var(--color-slate-700);
    font-weight: 500;
  }

  .service-features-list li svg {
    color: var(--color-secondary-500);
    flex-shrink: 0;
  }

  .service-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--color-primary-50);
    color: var(--color-primary-700);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .service-btn:hover {
    background: var(--color-primary-600);
    color: var(--color-white);
  }

  .emergency-strip {
    background: linear-gradient(135deg, var(--color-primary-950) 0%, var(--color-primary-900) 100%);
    color: var(--color-white);
    padding: 3rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .strip-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .strip-content h3 {
    color: var(--color-white);
    font-size: 1.6rem;
    margin-bottom: 0.35rem;
  }

  .strip-content p {
    color: #cbd5e1;
    font-size: 1rem;
  }

  @media (max-width: 1024px) {
    .services-directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
    .services-directory-grid {
      grid-template-columns: 1fr;
    }
    .strip-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
