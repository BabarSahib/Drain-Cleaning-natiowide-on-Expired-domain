---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContactSection from '../../components/ContactSection.astro';
import { services, getServiceImage, type ServiceItem } from '../../data/services';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services/" },
  { name: service.name }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "serviceType": "Drain Cleaning & Plumbing",
  "provider": {
    "@type": "PlumbingService",
    "name": "Rapid Flow Drain Pros",
    "telephone": "+1-877-823-0231",
    "url": "https://maxsonplumbing.com/"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "description": service.longDesc,
  "offers": {
    "@type": "Offer",
    "priceCurrency": "USD",
    "price": "Contact for flat-rate quote",
    "availability": "https://schema.org/InStock"
  }
};
---

<Layout
  title={service.metaTitle}
  description={service.metaDesc}
  canonicalUrl={`https://maxsonplumbing.com/services/${service.slug}/`}
>
  <Breadcrumb items={breadcrumbItems} />

  <!-- Service Hero -->
  <section class="service-hero">
    <div class="container hero-layout">
      <div class="hero-left">
        <span class="badge-pill">24/7 Professional Service</span>
        <h1 class="hero-title">{service.name} <span class="highlight-text">Nationwide</span></h1>
        <p class="hero-desc">{service.longDesc}</p>
        
        <div class="hero-highlights">
          {service.features.map((f) => (
            <div class="highlight-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>{f}</span>
            </div>
          ))}
        </div>

        <div class="hero-cta-group">
          <a href="tel:+18778230231" class="btn btn-emergency">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>Call (877) 823-0231 For Immediate Dispatch</span>
          </a>
          <a href="tel:+18778230231" class="btn btn-secondary">Direct Dispatch: (877) 823-0231</a>
        </div>
      </div>

      <!-- Hero Real Image Card -->
      <div class="hero-right">
        <div class="hero-img-card">
          <img 
            src={getServiceImage(service.slug)} 
            alt={`Professional ${service.name} Service`} 
            class="hero-feature-img"
          />
          <div class="hero-float-badge">
            <span class="flash-icon">⚡</span>
            <span>24/7 Professional Dispatch</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Stats Ribbon -->
  <section class="quick-stats-ribbon">
    <div class="container stats-row">
      <div class="stat-box">
        <span class="stat-val">24/7</span>
        <span class="stat-lbl">Emergency Response</span>
      </div>
      <div class="stat-box">
        <span class="stat-val">100%</span>
        <span class="stat-lbl">Clear Flow Guarantee</span>
      </div>
      <div class="stat-box">
        <span class="stat-val">30-45 Min</span>
        <span class="stat-lbl">Rapid Mobile Arrival</span>
      </div>
    </div>
  </section>

  <!-- Process & Why Choose Section -->
  <section class="section-padding content-section">
    <div class="container">
      <div class="two-col-layout">
        <div class="main-content-col">
          <h2>Our Professional {service.name} Process</h2>
          <p class="section-intro">Every service call is handled methodically by experienced drain cleaning technicians using modern diagnostic and clearing technology.</p>
          
          <div class="process-timeline">
            {service.processSteps.map((step, idx) => (
              <div class="timeline-step">
                <div class="step-badge">{idx + 1}</div>
                <div class="step-info">
                  <h4>{step.title}</h4>
                  <p>{step.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="common-causes-box">
            <h3>Primary Causes Of Blockages We Clear</h3>
            <div class="causes-grid">
              {service.commonCauses.map((cause) => (
                <div class="cause-item">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                  <span>{cause}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Service FAQs -->
          <div class="service-faqs-wrapper">
            <h3>Frequently Asked Questions About {service.name}</h3>
            <div class="faq-list">
              {service.faqs.map((faq) => (
                <div class="faq-card">
                  <h4>{faq.q}</h4>
                  <p>{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="sidebar-col">
          <div class="sidebar-card services-nav-card">
            <h4>All 19 Drain Services</h4>
            <ul class="sidebar-services-links">
              {services.map((s) => (
                <li>
                  <a href={`/services/${s.slug}/`} class={s.slug === service.slug ? "active-link" : ""}>
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="sidebar-card emergency-callout-card">
            <h4>24/7 National Dispatch</h4>
            <p>Direct line to local mobile rooter & hydro jetting crews.</p>
            <a href="tel:+18778230231" class="sidebar-phone-btn">
              (877) 823-0231
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <ContactSection />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

<style>
  .service-hero {
    background: linear-gradient(160deg, #040d1f 0%, #0a1e3d 40%, #0f2847 70%, #132e52 100%);
    color: var(--color-white);
    padding: 4.5rem 0;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }

  .badge-pill {
    background: rgba(234, 88, 12, 0.2);
    border: 1px solid rgba(234, 88, 12, 0.45);
    color: #fb923c;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.6rem;
    color: var(--color-white);
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .hero-highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: #e2e8f0;
    font-weight: 500;
  }

  .highlight-item svg {
    color: #22c55e;
    flex-shrink: 0;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-right {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-img-card {
    position: relative;
    width: 100%;
    max-width: 500px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
    border: 2px solid rgba(255, 255, 255, 0.15);
    background: #0f172a;
  }

  .hero-feature-img {
    width: 100%;
    height: 310px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hero-img-card:hover .hero-feature-img {
    transform: scale(1.03);
  }

  .hero-float-badge {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
  }

  .flash-icon {
    color: #f59e0b;
    font-size: 1rem;
  }

  /* Quick Stats Ribbon */
  .quick-stats-ribbon {
    background: #060e1d;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.75rem 0;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-val {
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .stat-lbl {
    font-size: 0.88rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .full-width {
    width: 100%;
    justify-content: center;
  }

  .content-section {
    background: var(--color-slate-50);
  }

  .two-col-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3.5rem;
  }

  .main-content-col h2 {
    font-size: 2rem;
    color: var(--color-primary-950);
    margin-bottom: 0.5rem;
  }

  .section-intro {
    font-size: 1.05rem;
    color: var(--color-slate-600);
    margin-bottom: 2rem;
  }

  .process-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .timeline-step {
    display: flex;
    gap: 1.25rem;
    background: var(--color-white);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-slate-200);
    box-shadow: var(--shadow-sm);
  }

  .step-badge {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, var(--color-primary-600) 0%, var(--color-accent-500) 100%);
    color: var(--color-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .step-info h4 {
    font-size: 1.15rem;
    color: var(--color-primary-950);
    margin-bottom: 0.35rem;
  }

  .step-info p {
    color: var(--color-slate-600);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  .common-causes-box {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-bottom: 3rem;
    box-shadow: var(--shadow-sm);
  }

  .common-causes-box h3 {
    font-size: 1.4rem;
    color: var(--color-primary-950);
    margin-bottom: 1.25rem;
  }

  .causes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .cause-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: var(--color-slate-700);
  }

  .cause-item svg {
    color: var(--color-alert-500);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .service-faqs-wrapper h3 {
    font-size: 1.5rem;
    color: var(--color-primary-950);
    margin-bottom: 1.25rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-card {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .faq-card h4 {
    font-size: 1.05rem;
    color: var(--color-primary-950);
    margin-bottom: 0.5rem;
  }

  .faq-card p {
    color: var(--color-slate-600);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Sidebar */
  .sidebar-card {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .sidebar-card h4 {
    font-size: 1.15rem;
    color: var(--color-primary-950);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary-500);
  }

  .sidebar-services-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
  }

  .sidebar-services-links a {
    color: var(--color-slate-700);
    text-decoration: none;
    font-size: 0.88rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    display: block;
    transition: all 0.15s ease;
  }

  .sidebar-services-links a:hover,
  .sidebar-services-links a.active-link {
    background: var(--color-primary-50);
    color: var(--color-primary-600);
    font-weight: 700;
  }

  .emergency-callout-card {
    background: linear-gradient(135deg, var(--color-primary-950) 0%, var(--color-primary-900) 100%);
    color: var(--color-white);
  }

  .emergency-callout-card h4 {
    color: var(--color-white);
    border-bottom-color: var(--color-accent-500);
  }

  .emergency-callout-card p {
    color: #cbd5e1;
    font-size: 0.88rem;
    margin-bottom: 1rem;
  }

  .sidebar-phone-btn {
    display: block;
    text-align: center;
    background: var(--color-alert-500);
    color: var(--color-white);
    padding: 0.75rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1.1rem;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
  }

  @media (max-width: 1024px) {
    .hero-layout, .two-col-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
    .hero-highlights, .causes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
