---
// ContactSection.astro - Direct 24/7 Phone Dispatch Hub
---
<section id="contact" class="section-padding contact-section">
  <div class="container">
    <div class="contact-grid">
      <!-- Left Info Box -->
      <div class="contact-info-col">
        <span class="section-tag">24/7 National Dispatch Hub</span>
        <h2>Schedule Immediate Drain & Sewer Service</h2>
        <p class="contact-lead-text">
          Our dispatch coordinators are on standby 24 hours a day to resolve standing water, sewer backups, gurgling toilets, and severe main line blockages. Call our direct hotline for instant technician routing to your property.
        </p>

        <div class="contact-cards-list">
          <div class="info-card">
            <div class="info-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div>
              <span class="info-label">Direct 24/7 Phone Dispatch</span>
              <a href="tel:+18778230231" class="info-val phone-link">(877) 823-0231</a>
              <span class="info-sub">Zero hold time • Instant local technician routing</span>
            </div>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div>
              <span class="info-label">Operating Schedule</span>
              <span class="info-val">Open 24 Hours, 365 Days a Year</span>
              <span class="info-sub">Including nights, weekends & all national holidays</span>
            </div>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div>
              <span class="info-label">Nationwide Coverage Network</span>
              <span class="info-val">All 50 States & Over 30,000 Communities</span>
              <span class="info-sub">Average local arrival window is 30 to 45 minutes</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Emergency Call Card (Replaces lead form) -->
      <div class="contact-call-col">
        <div class="dispatch-cta-card">
          <div class="dispatch-card-header">
            <div class="status-indicator">
              <span class="pulse-dot"></span>
              <span>Local Master Technicians Available Now</span>
            </div>
            <h3>Speak Directly With Dispatch</h3>
            <p>Skip automated bots. Call our 24/7 direct phone line to speak immediately with a licensed drain coordinator.</p>
          </div>

          <div class="call-action-box">
            <span class="phone-label">TOLL-FREE 24/7 SERVICE LINE</span>
            <a href="tel:+18778230231" class="large-phone-btn">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>(877) 823-0231</span>
            </a>
          </div>

          <div class="dispatch-guarantees">
            <div class="guarantee-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>30-45 Minute Average On-Site Arrival</span>
            </div>
            <div class="guarantee-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>100% Upfront Written Flat-Rate Quotes</span>
            </div>
            <div class="guarantee-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Licensed, Insured & Background-Checked</span>
            </div>
            <div class="guarantee-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>No Overtime, Night, or Weekend Surcharges</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--color-slate-50);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .contact-lead-text {
    color: var(--color-slate-600);
    font-size: 1.05rem;
    margin: 1.25rem 0 2rem 0;
    line-height: 1.6;
  }

  .contact-cards-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .info-card {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    padding: 1.2rem 1.4rem;
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    box-shadow: var(--shadow-sm);
  }

  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-primary-600);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-label {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-slate-500);
    letter-spacing: 0.05em;
  }

  .info-val {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-primary-950);
    margin-top: 0.15rem;
  }

  .phone-link {
    color: var(--color-alert-500);
    transition: color 0.2s ease;
  }

  .phone-link:hover {
    color: var(--color-alert-600);
  }

  .info-sub {
    display: block;
    font-size: 0.8rem;
    color: var(--color-slate-500);
    margin-top: 0.15rem;
  }

  /* Right Call Card */
  .dispatch-cta-card {
    background: linear-gradient(145deg, #040d1f 0%, #0a1e3d 50%, #0f2847 100%);
    color: var(--color-white);
    border-radius: var(--radius-xl);
    padding: 2.75rem 2.5rem;
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.35);
    color: #4ade80;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
  }

  .dispatch-card-header h3 {
    font-size: 1.7rem;
    color: var(--color-white);
    margin-bottom: 0.6rem;
  }

  .dispatch-card-header p {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .call-action-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .phone-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-accent-400);
    margin-bottom: 0.75rem;
  }

  .large-phone-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: var(--color-alert-500);
    color: var(--color-white);
    font-size: 1.5rem;
    font-weight: 800;
    padding: 1rem 1.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(220, 38, 38, 0.4);
    transition: all 0.2s ease;
    width: 100%;
  }

  .large-phone-btn:hover {
    background: var(--color-alert-600);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(220, 38, 38, 0.5);
  }

  .dispatch-guarantees {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
  }

  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: #e2e8f0;
    font-weight: 500;
  }

  .guarantee-item svg {
    color: #22c55e;
    flex-shrink: 0;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .dispatch-cta-card {
      padding: 1.75rem 1.25rem;
    }
    .large-phone-btn {
      font-size: 1.25rem;
      padding: 0.85rem 1rem;
    }
  }
</style>
