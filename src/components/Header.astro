---
// Header.astro
import { allStatesList } from '../data/locations';
---
<header class="site-header">
  <!-- Top Urgent Bar -->
  <div class="top-bar">
    <div class="container top-bar-content">
      <div class="top-bar-left">
        <span class="live-pulse"></span>
        <span class="top-bar-text"><strong>24/7 Nationwide Emergency Dispatch</strong> • Direct Local Technicians on Standby</span>
      </div>
      <div class="top-bar-right">
        <span>Average Response: <strong>30-45 Mins</strong></span>
        <span class="divider">|</span>
        <a href="tel:+18778230231" class="top-bar-phone">Direct Line: (877) 823-0231</a>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="main-nav-wrapper">
    <div class="container nav-container">
      <a href="/" class="brand-logo" aria-label="Rapid Flow Drain Pros Home">
        <div class="logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
            <path d="M12 12c.5 1.5 2 2 3 2"></path>
          </svg>
        </div>
        <div class="logo-text">
          <span class="brand-name">RAPID FLOW</span>
          <span class="brand-sub">DRAIN & SEWER PROS</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <a href="/" class="nav-link">Home</a>

        <!-- Service Areas Mega Menu (furnacerepairpros.com style) -->
        <div class="nav-dropdown">
          <a href="/#locations" class="nav-link dropdown-toggle">
            Service Areas
            <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
          <div class="dropdown-menu mega-menu-states">
            <div class="states-grid-4col">
              {allStatesList.map((st) => (
                <a href={`/states/${st.slug}/`} class="state-mega-item">
                  {st.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Services Dropdown -->
        <div class="nav-dropdown">
          <a href="/services/" class="nav-link dropdown-toggle">
            Services
            <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
          <div class="dropdown-menu">
            <a href="/services/emergency-drain-cleaning/" class="dropdown-item">
              <strong>Emergency Drain Cleaning</strong>
              <span>Fast clearing of residential sinks, tubs, and main lines</span>
            </a>
            <a href="/services/hydro-jetting/" class="dropdown-item">
              <strong>High-Pressure Hydro Jetting</strong>
              <span>Industrial 4,000 PSI grease, scale, and root scouring</span>
            </a>
            <a href="/services/main-sewer-line-cleaning/" class="dropdown-item">
              <strong>Main Sewer Line Cleaning</strong>
              <span>Whole-building lateral rooter & video inspection</span>
            </a>
            <a href="/services/commercial-drain-cleaning/" class="dropdown-item">
              <strong>Commercial Drain Cleaning</strong>
              <span>Grease trap cleaning and commercial facility maintenance</span>
            </a>
            <a href="/services/" class="dropdown-item view-all-item">
              <strong>→ Browse All 19 Services</strong>
              <span>Full list of specialized residential & commercial solutions</span>
            </a>
          </div>
        </div>

        <a href="/about/" class="nav-link">About Us</a>
        <a href="/contact/" class="nav-link">Contact</a>
      </nav>

      <!-- Action Buttons -->
      <div class="nav-actions">
        <a href="tel:+18778230231" class="btn btn-emergency nav-phone-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <div class="phone-btn-text">
            <span class="sub-label">24/7 CALL NOW</span>
            <span class="main-number">(877) 823-0231</span>
          </div>
        </a>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-toggle" class="mobile-toggle" aria-label="Toggle mobile menu" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer">
    <nav class="mobile-nav">
      <a href="/" class="mobile-nav-link">Home</a>
      <a href="/services/" class="mobile-nav-link">All 19 Services</a>
      <a href="/#locations" class="mobile-nav-link">States & Cities Directory</a>
      <a href="/about/" class="mobile-nav-link">About Us</a>
      <a href="/contact/" class="mobile-nav-link">Contact & Dispatch</a>
    </nav>
    <div class="mobile-cta-box">
      <p>Dealing with an urgent sewer backup?</p>
      <a href="tel:+18778230231" class="btn btn-emergency" style="width: 100%;">
        Call (877) 823-0231
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .top-bar {
    background: var(--color-primary-950);
    color: var(--color-slate-300);
    font-size: 0.82rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-bar-left, .top-bar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .divider {
    opacity: 0.3;
  }

  .top-bar-phone {
    color: var(--color-accent-400);
    font-weight: 700;
  }

  .main-nav-wrapper {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-slate-200);
    padding: 0.75rem 0;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--color-primary-600) 0%, var(--color-accent-500) 100%);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    box-shadow: 0 4px 10px rgba(37, 99, 235, 0.28);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--color-primary-950);
    line-height: 1.1;
  }

  .brand-sub {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-primary-600);
    letter-spacing: 0.12em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  .nav-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-slate-700);
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--color-primary-600);
  }

  .nav-dropdown {
    position: relative;
    padding: 0.5rem 0;
  }

  .chevron {
    transition: transform 0.2s ease;
  }

  .nav-dropdown:hover .chevron {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: -20px;
    width: 320px;
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xl);
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mega-menu-states {
    width: 680px;
    left: -120px;
    padding: 1.25rem;
    max-height: 480px;
    overflow-y: auto;
  }

  .states-grid-4col {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem 1rem;
  }

  .state-mega-item {
    font-size: 0.85rem;
    color: var(--color-slate-700);
    text-decoration: none;
    padding: 0.3rem 0.45rem;
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .state-mega-item:hover {
    background-color: var(--color-primary-50);
    color: var(--color-primary-600);
    font-weight: 600;
  }

  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    transition: background-color 0.15s ease;
  }

  .dropdown-item:hover {
    background-color: var(--color-slate-50);
  }

  .dropdown-item strong {
    font-size: 0.9rem;
    color: var(--color-primary-950);
  }

  .dropdown-item span {
    font-size: 0.75rem;
    color: var(--color-slate-600);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-phone-btn {
    padding: 0.55rem 1.2rem;
    border-radius: var(--radius-md);
  }

  .phone-btn-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.1;
  }

  .phone-btn-text .sub-label {
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    opacity: 0.9;
  }

  .phone-btn-text .main-number {
    font-size: 1rem;
    font-weight: 800;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .mobile-toggle .bar {
    width: 24px;
    height: 2.5px;
    background-color: var(--color-primary-950);
    border-radius: 2px;
    transition: 0.3s;
  }

  .mobile-drawer {
    display: none;
    background: var(--color-white);
    border-top: 1px solid var(--color-slate-200);
    padding: 1.25rem 1.5rem;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-slate-800);
  }

  @media (max-width: 992px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .top-bar-right {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .top-bar {
      display: none;
    }
    .nav-phone-btn {
      display: none;
    }
    .main-nav-wrapper {
      padding: 0.85rem 0;
    }
    .brand-name {
      font-size: 1.15rem;
    }
    .brand-sub {
      font-size: 0.65rem;
    }
    .logo-icon {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const drawer = document.getElementById('mobile-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('open');
      drawer.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', (!isOpen).toString());
    });
  }
</script>
