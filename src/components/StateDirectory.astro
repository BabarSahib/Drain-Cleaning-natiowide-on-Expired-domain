---
// StateDirectory.astro
import { allStatesList, getStateData } from '../data/locations';

const statesWithData = allStatesList.map((st) => {
  const data = getStateData(st.slug);
  return {
    name: st.name,
    slug: st.slug,
    abbr: st.abbr,
    cities: data ? data.cities : []
  };
});
---

<section id="locations" class="section-padding state-directory-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Nationwide Coverage</span>
      <h2>Select Your State For Fast Local Drain Service</h2>
      <p>We dispatch certified drain and sewer specialists across all 50 states. Select your location below to see available local response units, municipal code details, and upfront rates.</p>

      <div class="state-search-box">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="state-search-input" placeholder="Type your state or city (e.g., Texas, Austin, Florida)..." />
      </div>
    </div>

    <div class="state-cards-grid" id="state-cards-container">
      {statesWithData.map((st) => (
        <div class="state-card" data-state={st.name.toLowerCase()} data-cities={st.cities.map((c: { name: string }) => c.name).join(" ").toLowerCase()}>
          <div class="state-card-header">
            <div class="state-flag-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <h3 class="state-title"><a href={`/states/${st.slug}/`}>{st.name}</a></h3>
            <span class="coverage-pill">24/7 Active</span>
          </div>
          <div class="cities-preview">
            <span class="cities-label">Popular Service Areas:</span>
            <div class="city-tags">
              {st.cities.slice(0, 5).map((city: { name: string; slug: string }) => (
                <a href={`/${st.slug}/${city.slug}/`} class="city-tag">
                  {city.name}
                </a>
              ))}
            </div>
          </div>
          <div class="state-card-action">
            <a href={`/states/${st.slug}/`} class="state-view-btn">
              View All {st.cities.length > 0 ? `${st.cities.length} ` : ''}{st.name} Cities & Rates
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Nationwide Help Callout -->
    <div class="nationwide-footer-box">
      <p>Don't see your specific town listed above? Our mobile drain units cover over 35,000 zip codes nationwide.</p>
      <a href="tel:+18778230231" class="btn btn-emergency">
        Call Dispatch For Immediate Availability: (877) 823-0231
      </a>
    </div>
  </div>
</section>

<style>
  .state-directory-section {
    background-color: var(--color-slate-50);
    border-top: 1px solid var(--color-slate-200);
    border-bottom: 1px solid var(--color-slate-200);
  }

  .state-search-box {
    position: relative;
    max-width: 540px;
    margin: 2rem auto 0 auto;
  }

  .search-icon {
    position: absolute;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-slate-400);
  }

  .state-search-box input {
    width: 100%;
    padding: 0.95rem 1.25rem 0.95rem 3.2rem;
    font-size: 1rem;
    font-family: var(--font-sans);
    border: 2px solid var(--color-slate-200);
    border-radius: var(--radius-full);
    outline: none;
    transition: all 0.2s ease;
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .state-search-box input:focus {
    border-color: var(--color-primary-600);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .state-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .state-card {
    background: var(--color-white);
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.22s ease;
    box-shadow: var(--shadow-sm);
  }

  .state-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary-400);
    box-shadow: var(--shadow-md);
  }

  .state-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }

  .state-flag-icon {
    width: 36px;
    height: 36px;
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-primary-600);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .state-title {
    font-size: 1.2rem;
    color: var(--color-primary-950);
    margin: 0;
    flex-grow: 1;
  }

  .coverage-pill {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-success);
    background: rgba(22, 163, 74, 0.1);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .cities-preview {
    margin-bottom: 1.4rem;
  }

  .cities-label {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-slate-500);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .city-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .city-tag {
    font-size: 0.8rem;
    background: var(--color-slate-100);
    color: var(--color-slate-700);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .city-tag:hover {
    background: var(--color-primary-600);
    color: var(--color-white);
  }

  .state-card-action {
    border-top: 1px solid var(--color-slate-100);
    padding-top: 1rem;
  }

  .state-view-btn {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-primary-600);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.15s ease;
  }

  .state-view-btn:hover {
    color: var(--color-primary-800);
  }

  .nationwide-footer-box {
    background: var(--color-primary-950);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nationwide-footer-box p {
    font-size: 1.05rem;
    color: var(--color-slate-300);
  }

  @media (max-width: 1024px) {
    .state-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .state-cards-grid {
      grid-template-columns: 1fr;
    }
    .nationwide-footer-box {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('state-search-input') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.state-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      cards.forEach((card) => {
        const stateName = card.getAttribute('data-state') || '';
        const cities = card.getAttribute('data-cities') || '';
        if (stateName.includes(query) || cities.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>
