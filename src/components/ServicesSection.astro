  {
    title: "Floor Drain Cleaning",
    slug: "floor-drain-cleaning",
    category: "residential",
    badge: "Basement & Laundry",
    desc: "Maintains basement, laundry room, and garage floor traps to prevent sewer gas leakage and torrential floor flooding.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="3" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="21"/><line x1="3" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="21" y2="12"/></svg>`
  },
  {
    title: "Garbage Disposal Clog Removal",
    slug: "garbage-disposal-clog-removal",
