    category: "residential",
    badge: "No Standing Water",
    desc: "Ends ankle-deep shower water by extracting deep hair tangles, mineral scale, and bath product coagulations.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 11V7a5 5 0 0 1 10 0v4"/><path d="M2 13h20"/><rect x="4" y="13" width="16" height="9" rx="2"/></svg>`
