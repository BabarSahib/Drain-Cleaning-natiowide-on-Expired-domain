---

<section id="services" class="section-padding services-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Complete Nationwide Drainage Catalog</span>
      <h2>19 Dedicated Drain & Sewer Services We Provide</h2>
      <p>From single fixture clogs in homes to large-scale municipal sewer laterals, storm culverts, and commercial kitchens—our licensed specialists have the equipment to clear any pipe.</p>

      <!-- Category Filter Tabs -->
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">All 19 Services</button>
        <button class="filter-tab" data-filter="emergency">Emergency & Jetting (5)</button>
        <button class="filter-tab" data-filter="residential">Residential Fixtures (7)</button>
        <button class="filter-tab" data-filter="sewer">Sewer Line Solutions (3)</button>
        <button class="filter-tab" data-filter="specialty">Commercial, Storm & Roof (4)</button>
      </div>
    </div>

    <!-- 19 Services Grid -->
    <div class="services-grid" id="services-grid-container">
      {allServices.map((svc) => (
        <div class="service-card" data-category={svc.category}>
          <div class="service-card-top">
            <div class="service-icon-box" set:html={svc.icon} />
            <span class="service-badge">{svc.badge}</span>
          </div>
          <h3 class="service-title">{svc.title}</h3>
          <p class="service-desc">{svc.desc}</p>
          <div class="service-footer">
            <a href={`/services/${svc.slug}/`} class="service-cta">
              View {svc.title} Details
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Hydro Jetting Callout Banner -->
    <div class="services-banner">
      <div class="banner-content">
        <div class="banner-badge">Advanced Technology</div>
        <h3>Tired of Drains That Clog Again Every Month?</h3>
        <p>Standard retail chemical cleaners and cheap rental snakes only punch a tiny 1-inch temporary hole. Our commercial hydro-jetters and HD sewer cameras locate the actual root cause and scrub the line 360 degrees clean to prevent callbacks.</p>
        <div class="banner-actions">
          <a href="tel:+18778230231" class="btn btn-emergency">
            Call For Same Day Service: (877) 823-0231
          </a>
          <a href="#locations" class="btn btn-secondary">
            Find Your City Technician
          </a>
        </div>
      </div>
      <div class="banner-image">
        <img src="/images/hydro-jetting-manhole.jpg" alt="Commercial Hydro Jetting Clearing Sewer Line" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--color-slate-50);
  }

  .filter-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .filter-tab {
    padding: 0.55rem 1.15rem;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-sans);
    border-radius: var(--radius-full);
    background: var(--color-white);
    color: var(--color-slate-700);
    border: 1px solid var(--color-slate-200);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-tab:hover {
    background: var(--color-slate-100);
    border-color: var(--color-slate-300);
  }

  .filter-tab.active {
    background: var(--color-primary-600);
    color: var(--color-white);
    border-color: var(--color-primary-600);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    margin-bottom: 4rem;
  }

  .service-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 1.8rem 1.6rem;
    border: 1px solid var(--color-slate-200);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.22s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-500);
  }

  .service-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.1rem;
  }

  .service-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-primary-600);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-badge {
    background: var(--color-slate-100);
    color: var(--color-slate-700);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .service-title {
    font-size: 1.18rem;
    margin-bottom: 0.6rem;
    color: var(--color-primary-950);
  }

  .service-desc {
    color: var(--color-slate-600);
    font-size: 0.9rem;
    margin-bottom: 1.4rem;
    line-height: 1.55;
    flex-grow: 1;
  }

  .service-footer {
    border-top: 1px solid var(--color-slate-100);
    padding-top: 1rem;
  }

  .service-cta {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--color-primary-600);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.2s ease;
  }

  .service-cta:hover {
    gap: 0.6rem;
    color: var(--color-primary-800);
  }

  /* Banner */
  .services-banner {
    background: linear-gradient(135deg, var(--color-primary-950) 0%, var(--color-primary-900) 100%);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .banner-content {
    padding: 3.5rem;
    color: var(--color-white);
  }

  .banner-badge {
    display: inline-block;
    background: rgba(56, 189, 248, 0.15);
    color: var(--color-accent-400);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .banner-content h3 {
    font-size: 2rem;
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .banner-content p {
    color: var(--color-slate-300);
    font-size: 1.02rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .banner-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .banner-image {
    height: 100%;
    position: relative;
    min-height: 320px;
  }

  .banner-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .services-banner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
    .banner-content {
      padding: 1.8rem;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.filter-tab');
  const serviceCards = document.querySelectorAll('.service-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = tab.getAttribute('data-filter');

      serviceCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
