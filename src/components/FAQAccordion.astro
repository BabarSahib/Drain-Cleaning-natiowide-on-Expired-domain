---
// FAQAccordion.astro
const faqs = [
  {
    q: "How quickly can a drain technician arrive at my home?",
    a: "Our nationwide dispatch network maintains local mobile service vehicles on active standby. In most metropolitan and suburban areas, a licensed drain specialist arrives at your door within 30 to 45 minutes of your phone call. For scheduled or non-emergency visits, we provide exact 2-hour arrival windows with advance courtesy calls."
  },
  {
    q: "What is the difference between traditional snaking and hydro-jetting?",
    a: "Traditional drain snaking (augering) pushes a steel cable through the pipe to punch a hole through an immediate clog and restore basic drainage. Hydro-jetting uses commercial-grade 4,000 PSI high-velocity water jets to physically scour the entire circumference of the pipe wall, completely eradicating built-up grease, mineral scale, and intrusive tree roots so clogs do not return."
  },
  {
    q: "Do you provide upfront pricing before starting any work?",
    a: "Yes, 100%. We believe in total pricing transparency. Your technician conducts a preliminary assessment (often including an HD camera view of the blockage) and provides a firm, flat-rate written quote before any work commences. The price you approve is the price you pay—there are never surprise travel fees or hidden disposal surcharges."
  },
  {
    q: "Can tree roots inside my sewer pipe be permanently removed?",
    a: "Tree roots naturally seek moisture and nutrients inside underground sewer line joints. We use heavy-duty mechanical root-cutting blades and hydro-jetting to obliterate existing root balls and flush them out. Following the clearing, we provide a video camera inspection to evaluate whether trenchless pipe relining or joint sealing is needed to permanently block future root intrusion."
  },
  {
    q: "What should I do while waiting for the emergency plumber to arrive?",
    a: "Immediately shut off water to the affected fixture, or shut off your home's main water supply valve if sewage is backing up into showers, bathtubs, or basement drains. Avoid running washing machines, dishwashers, or flushing toilets, as any additional wastewater will worsen the backup. Keep pets and family members away from contaminated areas."
  },
  {
    q: "Are chemical drain cleaners safe for my pipes?",
    a: "We strongly advise against liquid chemical drain cleaners. Most store-bought formulas use caustic acids or lye that generate intense exothermic heat, which can warp PVC joints, corrode older cast iron pipes, and create dangerous fumes. Furthermore, they rarely dissolve severe root or heavy grease clogs. Professional mechanical snaking or hydro-jetting is the only safe, permanent solution."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<section id="faq" class="section-padding faq-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Got Questions?</span>
      <h2>Frequently Asked Questions About Drain & Sewer Services</h2>
      <p>Clear, direct answers regarding emergency response times, upfront flat rates, and professional clearing techniques.</p>
    </div>

    <div class="faq-container">
      {faqs.map((item, idx) => (
        <div class={`faq-item ${idx === 0 ? 'active' : ''}`}>
          <button class="faq-question" aria-expanded={idx === 0 ? "true" : "false"}>
            <span class="faq-question-text">{item.q}</span>
            <span class="faq-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="faq-answer" style={idx === 0 ? 'max-height: 250px;' : 'max-height: 0px;'}>
            <div class="faq-answer-inner">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="faq-bottom-cta">
      <p>Have an urgent drain question we haven't answered here?</p>
      <a href="tel:+18778230231" class="btn btn-secondary">
        Speak With A Master Plumber: (877) 823-0231
      </a>
    </div>
  </div>

  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq-section {
    background: var(--color-white);
  }

  .faq-container {
    max-width: 820px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-md);
    background: var(--color-slate-50);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .faq-item.active {
    border-color: var(--color-primary-500);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    width: 100%;
    padding: 1.35rem 1.6rem;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary-950);
  }

  .faq-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-slate-200);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s ease, background-color 0.2s ease;
  }

  .faq-item.active .faq-icon {
    transform: rotate(180deg);
    background: var(--color-primary-600);
    color: var(--color-white);
  }

  .faq-answer {
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0, 1, 0, 1);
  }

  .faq-answer-inner {
    padding: 0 1.6rem 1.4rem 1.6rem;
    color: var(--color-slate-600);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .faq-bottom-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .faq-bottom-cta p {
    color: var(--color-slate-600);
    font-size: 1rem;
  }
</style>

<script>
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach((item) => {
    const questionBtn = item.querySelector('.faq-question');
    const answer = item.querySelector('.faq-answer') as HTMLElement;

    if (questionBtn && answer) {
      questionBtn.addEventListener('click', () => {
        const isActive = item.classList.contains('active');

        // Close other items
        faqItems.forEach((other) => {
          if (other !== item) {
            other.classList.remove('active');
            const otherBtn = other.querySelector('.faq-question');
            const otherAns = other.querySelector('.faq-answer') as HTMLElement;
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            if (otherAns) otherAns.style.maxHeight = '0px';
          }
        });

        // Toggle current item
        if (isActive) {
          item.classList.remove('active');
          questionBtn.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = '0px';
        } else {
          item.classList.add('active');
          questionBtn.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 30 + 'px';
        }
      });
    }
  });
</script>
